{# Renders the "ngremotemedia" RichText custom tag, override per design in "themes/<theme>/ngremotemedia/richtext/custom_tag.html.twig" #}
{% set location_id = params.locationId|default('') %}

{% include '@NetgenRemoteMedia/app/view_resource.html.twig' with {
    location: location_id matches '/^\\d+$/' ? ngrm_remote_resource_location(location_id) : null,
    css_class: params.cssClass|default(null),
    variation_name: params.variationName|default(null),
    variation_group: ibexa.configResolver.getParameter('richtext.variation_group', 'netgen_remote_media_ibexa'),
    alignment: params.alignment|default(null),
} only %}
